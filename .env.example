RAG_BACKEND=ollama          # ollama | offline (hash embeddings + extractive answers, no model needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_STORE=faiss          # faiss | chroma
INDEX_DIR=data/index
INBOX_DIR=data/inbox
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
# MIN_RELEVANCE=0.35        # cosine similarity below this = "not in the documents"
